.vercel

# Build Outputs
.next/
out/
build
dist
.source

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# DB
*.db

# Cache
.cache/

# Local worktrees
.worktrees/

# Overrides
compose.override.yml

# IntelliJ IDE
.idea

# TanStack Router generated cache
apps/web/.tanstack/
.pi/

# TypeScript incremental build state
*.tsbuildinfo

# Volcados de la base de datos generados por el servicio de copias
/backups/

# Artefactos locales de Claude Code y del arranque directo de la API: cambian
# en cada sesion y llevan rutas de la maquina de quien los genera.
.claude/settings.local.json
.claude/scheduled_tasks.lock
apps/api/_direct_dev.log

# Almacen local de pnpm. Sin `.npmrc` que lo situe fuera, `pnpm install` lo crea
# aqui cuando el directorio del usuario esta en otro sistema de ficheros, y son
# 1,4 GB de JSON que hacen fallar `biome ci` con mas de mil errores ajenos.
.pnpm-store/

# Playwright
test-results/
playwright-report/
