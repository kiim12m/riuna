# General URLs
RIUNA_CLIENT_URL=http://localhost:5173
# RIUNA_API_URL=http://localhost:1337      # optional - defaults to RIUNA_CLIENT_URL/api
# RIUNA_INTERNAL_API_URL=http://127.0.0.1:1337 # optional - internal MCP tool requests only
# CORS_ORIGINS=                            # optional - comma-separated; defaults to RIUNA_CLIENT_URL
# PORT=1337                                # optional - the port the API listens on; defaults to 1337

# Database
# DATABASE_URL=                            # optional: use this for host-native or external DB access
POSTGRES_DB=riuna
POSTGRES_USER=riuna
POSTGRES_PASSWORD=
# POSTGRES_HOST=postgres                   # Compose container default; use localhost for host-native API startup
# POSTGRES_PORT=5432
# Note: POSTGRES_DB and POSTGRES_USER alone do not enable derived connection mode.
# Derived DATABASE_URL is only used when POSTGRES_PASSWORD or an explicit host/port is set.

# Time zone: do NOT set it in this file. compose.yml also loads this file into
# the PostgreSQL container, which must stay in UTC (triggers write now() into
# columns without a zone). The API image already runs in Europe/Madrid, which
# is what "today" means across the app (docs/adr/049).

# Redis Pub/Sub for WebSockets (Optional) -> auto fallback to in memory
# Only one mode should be configured. Priority: Cluster > Sentinel > Standalone.

# Standalone
#REDIS_URL=

# Sentinel
#REDIS_SENTINELS=
#REDIS_SENTINEL_MASTER_NAME=mymaster
#REDIS_SENTINEL_PASSWORD=
#REDIS_SENTINEL_TLS=false

# Cluster
#REDIS_CLUSTER_NODES=

# Shared (Sentinel & Cluster)
#REDIS_PASSWORD=

# Authentication
# Generate with: openssl rand -hex 32
# If unset, a random secret is generated at startup (sessions won't survive restarts)
AUTH_SECRET=

# Local accounts (username + password, no email address).
# Only the instance admin can create them, from the workspace members page.
# Their synthetic addresses live in this reserved domain and are never emailed.
# RIUNA_LOCAL_ACCOUNT_DOMAIN=local.riuna

# GitHub SSO (Sign in with GitHub, OAuth App)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Legacy fallback for SSO (used only if GITHUB_OAUTH_* are unset)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub integration (GitHub App: repository sync, webhooks)
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_APP_NAME=

# SMTP Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REQUIRE_TLS=
# When SMTP is configured, sign-in uses email verification codes by default.
# Set to true to use email/password sign-in instead (invitations still use SMTP).
#DISABLE_EMAIL_OTP_SIGN_IN=false

# Cloud-mode abuse mitigations (only enable on hosted multi-tenant instances).
# When RIUNA_CLOUD=true: signup with disposable-email providers is blocked,
# Turnstile is required on /sign-up/email, guest accounts cannot send
# workspace invites, and per-IP rate limits apply to signup + invite paths.
#RIUNA_CLOUD=false

# Cloudflare Turnstile (signup captcha). Set the secret key to enforce;
# leave unset to skip verification (self-hosted).
#TURNSTILE_SECRET_KEY=
# Web container: the production image bakes "RIUNA_TURNSTILE_SITE_KEY" as a
# placeholder and apps/web/env.sh substitutes it at container start from this
# env var. For local dev (vite), set VITE_TURNSTILE_SITE_KEY in apps/web/.env.
#RIUNA_TURNSTILE_SITE_KEY=

# Sentry error tracking (Optional): errors are only reported when a DSN is set
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1         # 0.0 disables; default 0 (opt-in)
# SENTRY_PROFILES_SAMPLE_RATE=0.1      # 0.0 disables; default 0 (opt-in)
# SENTRY_RELEASE=                       # git SHA; ties events to source maps. Falls back to package.json version.
# SENTRY_API_TOKEN=                     # Used by scripts/provision-sentry-alerts.sh and scripts/provision-sentry-dashboards.sh. Scope: org:write. https://sentry.io/settings/account/api/auth-tokens/

# Cloud billing via Creem (Optional): only active when RIUNA_CLOUD=true
# and both keys are set. Self-hosted installs leave these empty; billing stays off.
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# CREEM_TEST_MODE=true                     # use Creem's sandbox API
# CREEM_PRODUCT_PERSONAL_MONTHLY=
# CREEM_PRODUCT_PERSONAL_ANNUAL=
# CREEM_PRODUCT_TEAM_MONTHLY=
# CREEM_PRODUCT_TEAM_ANNUAL=
# BILLING_TRIAL_DAYS=14
# BILLING_FOUNDING_CUTOFF=                 # ISO date; workspaces created on/before keep free access

# ─────────────────────────────────────────────────────────────────────────────
# Variables que la API lee y que hasta la Fase 4.5 no estaban documentadas en
# ningun sitio: ni aqui, ni en ENVIRONMENT_SETUP.md, ni en el chart. La peor era
# NOTIFICATION_SECRET_ENCRYPTION_KEY, que devuelve un 500 nombrando una variable
# que no aparecia en el repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# Cifrado de los secretos de notificacion (tokens de ntfy, Gotify, webhooks).
# Sin ella, guardar uno responde 500. Genera una con: openssl rand -base64 32
# NOTIFICATION_SECRET_ENCRYPTION_KEY=

# Acceso y registro
# DISABLE_REGISTRATION=false             # cierra el alta; el primer usuario entra igual (arranque del admin)
# DISABLE_PASSWORD_REGISTRATION=false    # alta solo por OAuth o invitacion
# DISABLE_LOGIN_FORM=                    # oculta el formulario y deja solo los proveedores
# DISABLE_GUEST_ACCESS=false             # apaga las cuentas anonimas de invitado
# DISABLE_WORKSPACE_CREATION=false       # solo el admin de instancia crea espacios
# DEMO_MODE=false                        # datos de ejemplo y nombres generados

# Red y cookies
# TRUSTED_PROXIES=                       # IP o redes (CIDR) separadas por comas; solo si la conexion llega de una de ellas se lee X-Forwarded-For. Por defecto, localhost y las redes privadas (docs/adr/074)
# RATE_LIMIT_ENABLED=true                # false apaga los limites de tasa (el humo y los simulacros lo hacen)
# RATE_LIMIT_USER_PER_MINUTE=600         # peticiones por minuto de cada persona o clave de API
# COOKIE_DOMAIN=                         # para compartir sesion entre subdominios
# RIUNA_ALLOW_PRIVATE_WEBHOOK_DESTINATIONS=false  # permite webhooks a IP privadas (solo desarrollo)

# Almacenamiento S3
# S3_FORCE_PATH_STYLE=false              # necesario con MinIO y compatibles
# S3_MAX_IMAGE_UPLOAD_BYTES=             # tope por imagen subida
# S3_PRESIGN_TTL_SECONDS=                # validez de las URL firmadas

# OAuth adicional (opcional). Los de GitHub y Gitea estan mas arriba.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# GITHUB_PRIVATE_KEY_BASE64=             # clave de la GitHub App, en base64

# OAuth generico contra un proveedor propio
# CUSTOM_OAUTH_CLIENT_ID=
# CUSTOM_OAUTH_CLIENT_SECRET=
# CUSTOM_OAUTH_DISCOVERY_URL=            # si el proveedor publica .well-known, basta con esto
# CUSTOM_OAUTH_AUTHORIZATION_URL=
# CUSTOM_OAUTH_TOKEN_URL=
# CUSTOM_OAUTH_USER_INFO_URL=
# CUSTOM_OAUTH_LOGOUT_URL=
# CUSTOM_OAUTH_SCOPES=openid,profile,email
# CUSTOM_OAUTH_RESPONSE_TYPE=code
# CUSTOM_OAUTH_AUTO_LOGIN=false          # redirige al proveedor sin pasar por el formulario
# CUSTOM_AUTH_PKCE=true

# Otras
# DEVICE_AUTH_CLIENT_IDS=riuna-cli       # clientes admitidos en el flujo de dispositivo
# TURNSTILE_TIMEOUT_MS=                  # plazo de la verificacion de Turnstile
# BILLING_REMINDER_MAX_PER_RUN=          # tope de avisos de facturacion por pasada del cron
# LOG_LEVEL=info                         # debug, info, warn o error (docs/adr/073)
# LOG_FORMAT=                            # json (por defecto con NODE_ENV=production, como en la imagen) o pretty
# RIUNA_DISABLE_SCHEDULER=false         # true: ningun trabajo programado; para instancias restauradas en un simulacro (ADR 072)

# Instancia en el PC (compose.local.yml), no la API. Ver docs/actualizar.md
# RIUNA_BIND_ADDRESS=127.0.0.1           # donde escuchan web, API y Postgres; 0.0.0.0 los abre a la red local
# BACKUP_INTERVAL_HOURS=24               # horas entre copias (docs/copias-de-seguridad.md)
# BACKUP_RETENTION_DAYS=14               # dias que se conservan las copias locales
# BACKUP_KEEP_MIN=3                      # copias recientes que no se purgan nunca
# COMPOSE_PROFILES=offsite               # enciende la copia externa, ya con el remoto creado
# OFFSITE_REMOTE=riuna-cifrado:copias    # remoto de rclone (docs/copias-de-seguridad.md)
# OFFSITE_INTERVAL_HOURS=6               # horas entre subidas
# OFFSITE_RETENTION_DAYS=90              # dias que se conservan fuera
# OFFSITE_KEEP_MIN=5                     # copias de fuera que no se purgan nunca
