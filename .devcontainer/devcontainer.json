// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	"name": "Node.js & TypeScript",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
	"features": {
		"ghcr.io/devcontainers/features/git:1": {},
		"ghcr.io/shyim/devcontainers-features/bun:0": {},
		// The image tops out at Node 22 and the root package.json requires >=24.
		"ghcr.io/devcontainers/features/node:1": {
			"version": "24"
		}
	},

	// Every node_modules is a named volume rather than part of the bind-mounted
	// worktree. On a Windows host the two toolchains cannot share one tree: a
	// container install writes WSL symlinks (reparse tag 0xa000001d) pointing at
	// absolute /workspaces paths, which Windows Node cannot traverse, and a host
	// install writes junctions the container cannot use. Shadowing these paths
	// lets each side keep its own install of the same lockfile.
	"mounts": [
		"source=riuna-nm-root,target=${containerWorkspaceFolder}/node_modules,type=volume",
		"source=riuna-nm-apps-api,target=${containerWorkspaceFolder}/apps/api/node_modules,type=volume",
		"source=riuna-nm-apps-web,target=${containerWorkspaceFolder}/apps/web/node_modules,type=volume",
		"source=riuna-nm-pkg-email,target=${containerWorkspaceFolder}/packages/email/node_modules,type=volume",
		"source=riuna-nm-pkg-libs,target=${containerWorkspaceFolder}/packages/libs/node_modules,type=volume",
		"source=riuna-nm-pkg-mcp,target=${containerWorkspaceFolder}/packages/mcp/node_modules,type=volume",
		"source=riuna-nm-pkg-permissions,target=${containerWorkspaceFolder}/packages/permissions/node_modules,type=volume",
		"source=riuna-nm-pkg-typescript-config,target=${containerWorkspaceFolder}/packages/typescript-config/node_modules,type=volume",
		// Survives rebuilds so a fresh container reinstalls from cache, not the network.
		"source=riuna-pnpm-store,target=/home/node/.pnpm-store,type=volume"
	],

	"containerEnv": {
		"npm_config_store_dir": "/home/node/.pnpm-store"
	},

	// Docker creates empty named volumes owned by root; pnpm runs as `node`.
	"onCreateCommand": "sudo chown node:node /home/node/.pnpm-store ${containerWorkspaceFolder}/node_modules ${containerWorkspaceFolder}/apps/*/node_modules ${containerWorkspaceFolder}/packages/*/node_modules",

	"postCreateCommand": "corepack enable pnpm && pnpm install",

	// PostgreSQL, en cada arranque del contenedor. Aqui no hay systemd —el PID 1
	// es un `sleep` en bucle—, asi que el `postgresql.service` que la imagen
	// declara no lo levanta nadie, y sin esto hay que acordarse del
	// `pg_ctlcluster` a mano cada vez que se reabre. El script es idempotente:
	// instala solo si falta y no tarda nada cuando ya esta todo.
	"postStartCommand": "bash scripts/dev-db.sh",

	// Solo el puerto de la web. La API se sirve por debajo de el (el proxy de
	// `apps/web/vite.config.ts`), asi que no hace falta reenviarla, y no es el
	// 5173 a proposito: ese lo ocupa la instancia de Docker, y con el reenvio
	// automatico el que arranca segundo acaba en un puerto distinto cada vez.
	// Ver `pnpm dev:parallel`.
	"forwardPorts": [5273],

	"portsAttributes": {
		"5273": { "label": "Riuna (desarrollo en paralelo)" }
	}

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
